# ============================================================
# EUREKA MULTIVERSE — environment template
# Copy to `.env` (in the repo root) and fill the real secret. NEVER commit `.env`.
# ============================================================

# --- Backend (holds the DeepSeek API key; ONLY the backend uses it) ---
# Secret: keep it only in the backend runtime.
DEEPSEEK_API_KEY=
# OpenAI-compatible DeepSeek endpoint (default in code: https://api.deepseek.com)
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model served by the cognitive engine (default in code: deepseek-chat)
DEEPSEEK_MODEL=deepseek-chat
# Engine selection: deepseek | ollama | test_double
COGNITIVE_ENGINE=deepseek
# Only used when COGNITIVE_ENGINE=ollama
OLLAMA_MODEL=deepseek-r1:14b

# Browser origins allowed to call the backend directly (comma-separated).
# Relevant only for non-Docker local dev (Vite :5173 -> backend :8000).
# In the Docker Compose setup the frontend reaches the API same-origin via nginx.
EUREKA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API base the FRONTEND build uses. Empty default => same-origin relative /api (nginx proxies /api
# to the backend). Set a real absolute origin ONLY for a split deployment (e.g. https://api.example.com).
VITE_EUREKA_API_URL=
